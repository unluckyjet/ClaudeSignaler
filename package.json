{
  "name": "claude-signaler",
  "version": "1.0.0",
  "private": true,
  "description": "Pauses your music, plays a cue and shakes the screen when Claude Code finishes a turn or needs you. Windows.",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "claude-code-hooks",
    "notification",
    "windows",
    "powershell",
    "cuelume",
    "screen-shake"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "scripts": {
    "render": "node scripts/render-sounds.js",
    "install-hooks": "node scripts/install.js",
    "uninstall-hooks": "node scripts/install.js --uninstall",
    "status": "node scripts/install.js --status",
    "test-cue": "node scripts/install.js --test",
    "help": "node scripts/install.js --help"
  },
  "dependencies": {
    "cuelume": "^0.2.2",
    "node-web-audio-api": "^2.2.0"
  }
}
